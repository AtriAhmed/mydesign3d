{
  "name": "mydesign3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cms:seed": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local scripts/seed-content.mjs",
    "cms:types": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --input-type=module -e 'import config from \"./payload.config.ts\"; import {generateTypes} from \"./node_modules/payload/dist/bin/generateTypes.js\"; await generateTypes(await config)'",
    "cms:migrate:consultation": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local scripts/migrate-consultation.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "graphql": "^16.14.2",
    "motion": "^14.2.0",
    "next": "16.4.2",
    "payload": "^3.91.0",
    "pg": "^8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
